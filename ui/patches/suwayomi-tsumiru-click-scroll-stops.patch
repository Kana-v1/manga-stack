diff --git a/lib/src/features/manga_book/presentation/reader/widgets/reader_mode/infinity_continuous/click_scroll_stops.dart b/lib/src/features/manga_book/presentation/reader/widgets/reader_mode/infinity_continuous/click_scroll_stops.dart
new file mode 100644
index 00000000..8bb48f93
--- /dev/null
+++ b/lib/src/features/manga_book/presentation/reader/widgets/reader_mode/infinity_continuous/click_scroll_stops.dart
@@ -0,0 +1,108 @@
+// manga-stack: in the long strip, a click (or key) that scrolls forward stops at the next speech
+// bubble or panel. Without this, it always moves the same share of the screen. Everything above
+// the reading line counts as read. The first stop below the line moves to just under the top
+// edge. A click never moves further than the scroll amount of the reader. So art without stops
+// moves at the usual speed, and nothing is skipped. The stops come from readahead
+// (/api/ocr): bubble boxes and panel tops, as fractions of each page (bubble_text_layer.dart).
+
+import 'dart:math' as math;
+
+import 'package:hooks_riverpod/hooks_riverpod.dart';
+import 'package:material_ui/material_ui.dart';
+
+import '../../../../../../../constants/db_keys.dart';
+import '../../../../../../../utils/mixin/shared_preferences_client_mixin.dart';
+import '../../../../../../../widgets/compact_switch.dart';
+import '../../chrome/tabs/int_slider_tile.dart';
+
+/// Room left above the stop, as a share of the screen.
+const _topMargin = 0.04;
+
+final clickScrollStopsProvider = NotifierProvider<ClickScrollStops, bool?>(
+  ClickScrollStops.new,
+);
+
+class ClickScrollStops extends Notifier<bool?>
+    with SharedPreferenceClientMixin<bool> {
+  @override
+  bool? build() => initialize(DBKeys.clickScrollStops);
+}
+
+/// The reading line, in percent of the screen from the top.
+final clickScrollLineProvider = NotifierProvider<ClickScrollLine, int?>(
+  ClickScrollLine.new,
+);
+
+class ClickScrollLine extends Notifier<int?>
+    with SharedPreferenceClientMixin<int> {
+  @override
+  int? build() => initialize(DBKeys.clickScrollLinePercent);
+}
+
+/// The stops of the pages on the screen (and just outside it), as fractions of the height of
+/// each page. The key is the element of the page. A page registers its stops while it is mounted.
+abstract final class ScrollStops {
+  static final _pages = <BuildContext, List<double>>{};
+
+  static void set(BuildContext page, List<double> stops) =>
+      _pages[page] = stops;
+
+  static void remove(BuildContext page) => _pages.remove(page);
+
+  /// How far to scroll forward from [position], at most [step] pixels. The scroll brings the
+  /// first stop below the reading line ([line], a share of the screen) to just under the top edge.
+  static double next(ScrollPosition position, double step, double line) {
+    final viewport = position.context.storageContext.findRenderObject();
+    if (viewport is! RenderBox || !viewport.hasSize) return step;
+    final height = viewport.size.height;
+    double? nearest;
+    for (final MapEntry(key: page, value: stops) in _pages.entries) {
+      final box = page.mounted ? page.findRenderObject() : null;
+      if (box is! RenderBox || !box.attached || !box.hasSize) continue;
+      for (final stop in stops) {
+        // The stop in the viewport's own coordinates, which are scroll pixels.
+        final y = viewport
+            .globalToLocal(box.localToGlobal(Offset(0, stop * box.size.height)))
+            .dy;
+        if (y > height * line && (nearest == null || y < nearest)) nearest = y;
+      }
+    }
+    if (nearest == null) return step;
+    return math.min(step, nearest - height * _topMargin);
+  }
+}
+
+/// The settings, shown with the long strip's scroll amount.
+class ClickScrollStopsSettings extends ConsumerWidget {
+  const ClickScrollStopsSettings({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final enabled =
+        ref.watch(clickScrollStopsProvider) ??
+        DBKeys.clickScrollStops.initial as bool;
+    final line =
+        ref.watch(clickScrollLineProvider) ??
+        DBKeys.clickScrollLinePercent.initial as int;
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        CompactSwitchListTile(
+          controlAffinity: ListTileControlAffinity.trailing,
+          title: const Text('Scroll to the next bubble or panel'),
+          value: enabled,
+          onChanged: ref.read(clickScrollStopsProvider.notifier).update,
+        ),
+        if (enabled)
+          IntSliderTile(
+            title: 'Reading line (bubbles above it count as read)',
+            valueLabel: '$line% of the screen',
+            value: line,
+            min: 10,
+            max: 80,
+            onChanged: ref.read(clickScrollLineProvider.notifier).update,
+          ),
+      ],
+    );
+  }
+}
