@@ -0,0 +1,323 @@
+// manga-stack: in the long strip, a click (or key) that scrolls forward stops at the next speech
+// bubble or panel. Without this, it always moves the same share of the screen. Everything above
+// the reading line counts as read. The first stop below the line moves to just under the top
+// edge. A click never moves further than the scroll amount of the reader. So art without stops
+// moves at the usual speed, and nothing is skipped. The stops come from readahead
+// (/api/ocr): bubble boxes and panel tops, as fractions of each page (bubble_text_layer.dart).
+//
+// A mark shows where the next click stops: two short bars, in the margins at the left and right
+// of the page column. They are at the top of the next bubble or panel. When no stop is in reach,
+// they are where the full scroll amount ends. The marked line is the line that moves to the top.
+
+import 'dart:math' as math;
+
+import 'package:flutter/scheduler.dart';
+import 'package:flutter_hooks/flutter_hooks.dart';
+import 'package:hooks_riverpod/hooks_riverpod.dart';
+import 'package:material_ui/material_ui.dart';
+
+import '../../../../../../../constants/db_keys.dart';
+import '../../../../../../../utils/mixin/shared_preferences_client_mixin.dart';
+import '../../../../../../../widgets/compact_switch.dart';
+import '../../chrome/tabs/int_slider_tile.dart';
+
+/// Room left above the stop, as a share of the screen.
+const _topMargin = 0.04;
+
+/// The bars of the mark: length, thickness and space from the page, in pixels.
+const _barLength = 20.0;
+const _barThickness = 3.0;
+const _barGap = 6.0;
+
+final clickScrollStopsProvider = NotifierProvider<ClickScrollStops, bool?>(
+  ClickScrollStops.new,
+);
+
+class ClickScrollStops extends Notifier<bool?>
+    with SharedPreferenceClientMixin<bool> {
+  @override
+  bool? build() => initialize(DBKeys.clickScrollStops);
+}
+
+/// The reading line, in percent of the screen from the top.
+final clickScrollLineProvider = NotifierProvider<ClickScrollLine, int?>(
+  ClickScrollLine.new,
+);
+
+class ClickScrollLine extends Notifier<int?>
+    with SharedPreferenceClientMixin<int> {
+  @override
+  int? build() => initialize(DBKeys.clickScrollLinePercent);
+}
+
+/// Whether a mark shows where the next forward click stops.
+final clickScrollMarkProvider = NotifierProvider<ClickScrollMark, bool?>(
+  ClickScrollMark.new,
+);
+
+class ClickScrollMark extends Notifier<bool?>
+    with SharedPreferenceClientMixin<bool> {
+  @override
+  bool? build() => initialize(DBKeys.clickScrollMark);
+}
+
+/// A stop of one page: the page (the key in [ScrollStops]) and the index in its list of stops.
+typedef PageStop = ({BuildContext page, int index});
+
+/// The stops of the pages on the screen (and just outside it), as fractions of the height of
+/// each page. The key is the element of the page. A page registers its stops while it is mounted.
+abstract final class ScrollStops {
+  static final _pages = <BuildContext, List<double>>{};
+
+  /// The stop that the next forward click brings to the top. The page that has it draws the
+  /// mark. Null when no stop is in reach, or when the mark is off.
+  static final marked = ValueNotifier<PageStop?>(null);
+
+  /// Called when a page adds or removes its stops. [NextStopMarks] sets it.
+  static VoidCallback? _onChange;
+
+  static void set(BuildContext page, List<double> stops) {
+    _pages[page] = stops;
+    _onChange?.call();
+  }
+
+  static void remove(BuildContext page) {
+    _pages.remove(page);
+    _onChange?.call();
+  }
+
+  /// The stop that a forward click from [position] brings to just under the top edge, and how
+  /// far that click scrolls. It is the first stop below the reading line ([line], a share of
+  /// the screen). Null when that stop is more than [step] pixels away, or when there is none.
+  static ({PageStop stop, double offset})? find(
+    ScrollPosition position,
+    double step,
+    double line,
+  ) {
+    final viewport = position.context.storageContext.findRenderObject();
+    if (viewport is! RenderBox || !viewport.hasSize) return null;
+    final height = viewport.size.height;
+    ({PageStop stop, double y})? nearest;
+    for (final MapEntry(key: page, value: stops) in _pages.entries) {
+      final box = page.mounted ? page.findRenderObject() : null;
+      if (box is! RenderBox || !box.attached || !box.hasSize) continue;
+      for (final (index, stop) in stops.indexed) {
+        // The stop in the viewport's own coordinates, which are scroll pixels.
+        final y = viewport
+            .globalToLocal(box.localToGlobal(Offset(0, stop * box.size.height)))
+            .dy;
+        if (y > height * line && (nearest == null || y < nearest.y)) {
+          nearest = (stop: (page: page, index: index), y: y);
+        }
+      }
+    }
+    if (nearest == null) return null;
+    final offset = nearest.y - height * _topMargin;
+    if (offset > step) return null;
+    return (stop: nearest.stop, offset: offset);
+  }
+
+  /// How far to scroll forward from [position], at most [step] pixels (see [find]).
+  static double next(ScrollPosition position, double step, double line) =>
+      find(position, step, line)?.offset ?? step;
+}
+
+/// Shows where the next forward click stops. A page marks its own stop (bubble_text_layer.dart),
+/// so the mark moves with the page. This widget marks the end of the full scroll amount, when
+/// no stop is in reach. [child] is
+/// the list of the long strip.
+class NextStopMarks extends HookConsumerWidget {
+  const NextStopMarks({
+    super.key,
+    required this.position,
+    required this.stepFraction,
+    required this.columnWidth,
+    required this.child,
+  });
+
+  /// The scroll position of the list. Null while the list has none.
+  final ScrollPosition? Function() position;
+
+  /// The scroll amount of the reader, as a share of the screen.
+  final double stepFraction;
+
+  /// The width of the page column, in pixels.
+  final double columnWidth;
+
+  final Widget child;
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final enabled =
+        (ref.watch(clickScrollStopsProvider) ??
+            DBKeys.clickScrollStops.initial as bool) &&
+        (ref.watch(clickScrollMarkProvider) ??
+            DBKeys.clickScrollMark.initial as bool);
+    final line =
+        ref.watch(clickScrollLineProvider) ??
+        DBKeys.clickScrollLinePercent.initial as int;
+    // Where the full scroll amount ends, in pixels from the top. Null when a stop is in reach.
+    final fullStep = useState<double?>(null);
+
+    // 1. Find the next stop. The mark goes on it, or on the end of the full scroll amount.
+    void update() {
+      final pos = position();
+      PageStop? stop;
+      double? full;
+      if (enabled &&
+          pos != null &&
+          pos.hasContentDimensions &&
+          pos.axisDirection == AxisDirection.down) {
+        final step = pos.viewportDimension * stepFraction;
+        final found = ScrollStops.find(pos, step, line / 100);
+        stop = found?.stop;
+        // At the end of the strip, the click moves only to the end.
+        final room = math.min(step, pos.maxScrollExtent - pos.pixels);
+        if (found == null && room > 1) full = room;
+      }
+      ScrollStops.marked.value = stop;
+      fullStep.value = full;
+    }
+
+    // 2. Do the update after the layout of the frame, because it reads the positions of the
+    //    pages. Many requests in one frame give one update.
+    final latestUpdate = useRef(update);
+    latestUpdate.value = update;
+    final scheduled = useRef(false);
+    final schedule = useCallback(() {
+      if (scheduled.value) return;
+      scheduled.value = true;
+      SchedulerBinding.instance.addPostFrameCallback((_) {
+        scheduled.value = false;
+        if (context.mounted) latestUpdate.value();
+      });
+      SchedulerBinding.instance.ensureVisualUpdate();
+    }, const []);
+
+    // 3. Update when pages add or remove stops, when the list scrolls or changes size, and
+    //    after each build (a setting can change).
+    useEffect(() {
+      ScrollStops._onChange = schedule;
+      return () => ScrollStops._onChange = null;
+    }, const []);
+    schedule();
+
+    return Stack(
+      fit: StackFit.passthrough,
+      children: [
+        NotificationListener<Notification>(
+          onNotification: (notification) {
+            if (notification is ScrollNotification ||
+                notification is ScrollMetricsNotification) {
+              schedule();
+            }
+            return false;
+          },
+          child: child,
+        ),
+        if (fullStep.value case final y?)
+          Positioned(
+            left: 0,
+            right: 0,
+            top: y - _barThickness / 2,
+            height: _barThickness,
+            child: IgnorePointer(
+              child: Center(
+                child: SizedBox(
+                  width: columnWidth,
+                  child: const StopEdgeBars(),
+                ),
+              ),
+            ),
+          ),
+      ],
+    );
+  }
+}
+
+/// The mark: a short bar at each side of the page column. Its parent is as wide as the column.
+/// The bars go in the margins beside the column. When a margin is too narrow for a bar, the
+/// bars go on the edges of the page.
+class StopEdgeBars extends StatelessWidget {
+  const StopEdgeBars({super.key});
+
+  @override
+  Widget build(BuildContext context) => LayoutBuilder(
+    builder: (context, size) {
+      final margin = (MediaQuery.sizeOf(context).width - size.maxWidth) / 2;
+      final inset = margin >= _barGap + _barLength
+          ? -(_barGap + _barLength)
+          : 0.0;
+      final bar = ColoredBox(
+        color: Theme.of(context).colorScheme.primary.withValues(alpha: 0.9),
+      );
+      return Stack(
+        clipBehavior: Clip.none,
+        children: [
+          Positioned(
+            left: inset,
+            top: 0,
+            width: _barLength,
+            height: _barThickness,
+            child: bar,
+          ),
+          Positioned(
+            right: inset,
+            top: 0,
+            width: _barLength,
+            height: _barThickness,
+            child: bar,
+          ),
+        ],
+      );
+    },
+  );
+}
+
+/// The thickness of the bars, for a page that places them.
+const stopBarThickness = _barThickness;
+
+/// The settings, shown with the long strip's scroll amount.
+class ClickScrollStopsSettings extends ConsumerWidget {
+  const ClickScrollStopsSettings({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final enabled =
+        ref.watch(clickScrollStopsProvider) ??
+        DBKeys.clickScrollStops.initial as bool;
+    final line =
+        ref.watch(clickScrollLineProvider) ??
+        DBKeys.clickScrollLinePercent.initial as int;
+    final mark =
+        ref.watch(clickScrollMarkProvider) ??
+        DBKeys.clickScrollMark.initial as bool;
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        CompactSwitchListTile(
+          controlAffinity: ListTileControlAffinity.trailing,
+          title: const Text('Scroll to the next bubble or panel'),
+          value: enabled,
+          onChanged: ref.read(clickScrollStopsProvider.notifier).update,
+        ),
+        if (enabled) ...[
+          IntSliderTile(
+            title: 'Reading line (bubbles above it count as read)',
+            valueLabel: '$line% of the screen',
+            value: line,
+            min: 10,
+            max: 80,
+            onChanged: ref.read(clickScrollLineProvider.notifier).update,
+          ),
+          CompactSwitchListTile(
+            controlAffinity: ListTileControlAffinity.trailing,
+            title: const Text('Mark where the next click stops'),
+            value: mark,
+            onChanged: ref.read(clickScrollMarkProvider.notifier).update,
+          ),
+        ],
+      ],
+    );
+  }
+}
