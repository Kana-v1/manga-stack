index 00000000..9dd926a6
--- /dev/null
+++ b/lib/src/features/manga_book/presentation/reader/widgets/reader_navigation_layout/page_column_cutout.dart
@@ -0,0 +1,44 @@
+// manga-stack: in the long-strip reader, a click on the page column goes to the page (its
+// bubble text), not to the tap zones. Only the margins beside the page move the reader.
+
+import 'package:flutter/rendering.dart';
+import 'package:flutter/widgets.dart';
+
+/// Width of the long-strip page column, centred on the screen. The long-strip reader sets it
+/// during layout, and a click reads it. Null in other reader modes.
+abstract final class PageColumn {
+  static double? width;
+}
+
+/// Lets clicks over the page column pass by [child] (the tap zones) to the page below.
+class PageColumnCutout extends SingleChildRenderObjectWidget {
+  const PageColumnCutout({super.key, required this.enabled, super.child});
+
+  final bool enabled;
+
+  @override
+  RenderObject createRenderObject(BuildContext context) =>
+      RenderPageColumnCutout(enabled);
+
+  @override
+  void updateRenderObject(
+    BuildContext context,
+    RenderPageColumnCutout renderObject,
+  ) => renderObject.enabled = enabled;
+}
+
+class RenderPageColumnCutout extends RenderProxyBox {
+  RenderPageColumnCutout(this.enabled);
+
+  bool enabled;
+
+  @override
+  bool hitTest(BoxHitTestResult result, {required Offset position}) {
+    final column = PageColumn.width;
+    if (enabled && column != null) {
+      final left = (size.width - column) / 2;
+      if (position.dx >= left && position.dx <= left + column) return false;
+    }
+    return super.hitTest(result, position: position);
+  }
+}
