+// manga-stack: a link inside another link. The outer <a> covers the whole outer widget, so
+// the browser never sees the <a> of the inner link. Thus the inner link makes no <a>. While the
+// mouse is over it, the outer <a> takes its location. A middle click or a Ctrl+click then opens
+// the inner location.
+class _WebRouteLinkState extends State<WebRouteLink> {
+  /// The location of the inner link under the mouse, and that link.
+  String? _lentLocation;
+  _WebRouteLinkState? _lentBy;
+
+  /// The outer link, when this link is inside one.
+  _WebRouteLinkState? _outer;
+
+  void _lend(_WebRouteLinkState inner, String? location) {
+    if (location == null && _lentBy != inner) return;
+    setState(() {
+      _lentLocation = location;
+      _lentBy = location == null ? null : inner;
+    });
+  }
+
+  @override
+  void dispose() {
+    // An unmounted MouseRegion sends no exit. Take the location back after this frame.
+    final outer = _outer;
+    if (outer != null) {
+      SchedulerBinding.instance.addPostFrameCallback((_) {
+        if (outer.mounted) outer._lend(this, null);
+      });
+    }
+    super.dispose();
+  }
+
